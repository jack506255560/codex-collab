{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-collab:event:v1",
  "title": "Codex Collab Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "task_id", "seq", "type", "actor_id", "occurred_at", "idempotency_key"],
  "allOf": [{
    "if": { "properties": { "type": { "const": "handoff" } }, "required": ["type"] },
    "then": {
      "required": ["summary", "refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "refs": {
          "type": "object", "required": ["branch", "commit", "tests"],
          "properties": {
            "branch": { "type": "string", "pattern": "^codex/[A-Za-z0-9][A-Za-z0-9._/-]{0,150}$" },
            "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$" },
            "tests": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    }
  }],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$" },
    "seq": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["created", "assigned", "run_started", "progress", "blocked", "run_failed", "handoff", "review_requested", "review_started", "review_note", "reviewed", "completed", "cancelled"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "maxLength": 4000 },
    "assignee": { "type": "string", "minLength": 1 },
    "chat_id": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["feishu", "wecom"] },
    "run_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approved", "changes_requested"] },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "pr": { "type": "string" },
        "tests": { "type": "string" }
      }
    }
  }
}

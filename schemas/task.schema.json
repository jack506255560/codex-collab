{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-collab:task:v1",
  "title": "Codex Collab Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repo", "title", "base_branch", "acceptance"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$" },
    "repo": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string" },
    "base_branch": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}

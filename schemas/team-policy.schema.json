{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-collab:team-policy:v2",
  "title": "Codex Collab Peer Team Policy v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "repo",
    "default_route",
    "reviewer",
    "agents",
    "routes",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "default_route": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "role",
          "capabilities",
          "max_concurrent_tasks",
          "public_key"
        ],
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            }
          },
          "max_concurrent_tasks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "public_key": {
            "type": "string",
            "minLength": 1
          },
          "wecom_userid": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim_timeout_ms",
        "lease_ms",
        "clock_skew_ms",
        "max_attempts"
      ],
      "properties": {
        "claim_timeout_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600000
        },
        "lease_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        },
        "clock_skew_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  },
  "$comment": "Runtime verifies distinct Ed25519 keys and owner IDs, valid reviewer and route capabilities, and clock skew below half the lease."
}
